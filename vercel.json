{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/free/",
      "has": [
        {
          "type": "host",
          "value": "neoulai.com"
        }
      ],
      "destination": "https://neoya.kr/free/",
      "permanent": true
    },
    {
      "source": "/free/:path+",
      "has": [
        {
          "type": "host",
          "value": "neoulai.com"
        }
      ],
      "destination": "https://neoya.kr/free/:path+",
      "permanent": true
    },
    {
      "source": "/free/",
      "has": [
        {
          "type": "host",
          "value": "www.neoulai.com"
        }
      ],
      "destination": "https://neoya.kr/free/",
      "permanent": true
    },
    {
      "source": "/free/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.neoulai.com"
        }
      ],
      "destination": "https://neoya.kr/free/:path+",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "neoulai.com"
        }
      ],
      "destination": "https://neoya.kr/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.neoulai.com"
        }
      ],
      "destination": "https://neoya.kr/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "neoulai.com"
        }
      ],
      "destination": "https://neoya.kr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.neoulai.com"
        }
      ],
      "destination": "https://neoya.kr/:path*",
      "permanent": true
    },
    {
      "source": "/free",
      "destination": "/free/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/"
    },
    {
      "source": "/app/:path*",
      "destination": "/"
    },
    {
      "source": "/free/",
      "destination": "https://neoya-download.vercel.app/"
    },
    {
      "source": "/free/:path*",
      "destination": "https://neoya-download.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "neoul-beta.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "neoya-beta.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
